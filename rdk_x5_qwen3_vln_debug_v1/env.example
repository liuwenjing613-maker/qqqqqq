# 不要把真实 API Key 提交到 Git。
export DASHSCOPE_API_KEY="sk-xxxxxxxxxxxxxxxx"

# 必须与 API Key / 业务空间地域一致。
# 北京业务空间示例：
# export QWEN_BASE_URL="https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
# 新加坡业务空间示例：
# export QWEN_BASE_URL="https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
export QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

export QWEN_MODEL="qwen3-vl-flash"

# 可选：用另一套提示词目录做 A/B 测试。
# export QWEN_PROMPT_DIR="/root/my_qwen_prompts"

# 可选：替换配置文件（两个名字等价）。
# export QWEN_CONFIG="/root/my_qwen3_vln_debug.yaml"
# export QWEN_VLN_CONFIG="/root/my_qwen3_vln_debug.yaml"

# 可选：覆盖相机订阅（默认读 yaml camera 段）。
# export IMAGE_TOPIC="/image_raw"
# export IMAGE_TRANSPORT="raw"
