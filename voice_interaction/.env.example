# Never commit your real API key.
DASHSCOPE_API_KEY=sk-your-key-here

# Existing general endpoint; workspace-specific endpoint may also be used.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_ASR_LANGUAGE=zh

# USB microphone (C-Media, ALSA card 0 / PyAudio index 0).
VOICE_DEVICE_INDEX=0
VOICE_ALSA_DEVICE=plughw:0,0
VOICE_USB_MIC_LEVEL=30
VOICE_RECORD_SECONDS=10
VOICE_RECORD_DIR=recordings

# Post-wake acknowledgment (play then record).
VOICE_ACK_FILE=assets/i_am_here.wav
VOICE_ACK_GAP_SECONDS=0.3
