# Copy to .env and fill in values. Do NOT commit .env to git.
# For Qwen API navigation (Flow C), export these before running start_qwen_api_lidar_nav.sh

DASHSCOPE_API_KEY=your_dashscope_api_key_here
QWEN_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=your_vision_model_name_here

# Optional: chassis port override (check ls -l /dev/ttyUSB* /dev/rosmaster on your board)
# CHASSIS_PORT=/dev/ttyUSB2

# Optional: camera device
# CAMERA_DEV=/dev/video0
